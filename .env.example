# ============================================
# LAR FORTE - VARIÁVEIS DE CONFIGURAÇÃO
# ============================================
#
# Copie este arquivo para .env.local e
# preencha os valores corretos para seu ambiente
#
# Nota: .env.local é ignorado pelo git por segurança
#

# ============================================
# FRONTEND - API E ENDPOINTS
# ============================================

# URL da API do backend
# Desenvolvimento local: http://localhost:3000
# Produção: https://seu-servidor.com
VITE_API_URL=http://localhost:3000

# ============================================
# MODO DE DESENVOLVIMENTO
# ============================================

# Define se está em desenvolvimento ou produção
# Valores: development, production
VITE_MODE=development

# ============================================
# LOGGING E DEBUG
# ============================================

# Ativa logs detalhados no console
# Valores: true, false
VITE_DEBUG_MODE=true

# ============================================
# CONFIGURAÇÕES FUTURAS (reservado)
# ============================================

# WhatsApp Business ID (se integrado no futuro)
# VITE_WHATSAPP_BUSINESS_ID=seu_id_aqui

# Google Maps API Key (se implementado mapa)
# VITE_GOOGLE_MAPS_KEY=sua_chave_aqui

# Timezone padrão
VITE_TIMEZONE=America/Sao_Paulo
